---
/** Full gallery: every photo directly in src/assets/photos/, masonry columns, native <dialog> lightbox. */
import { Picture, getImage } from 'astro:assets';
import Page from '../layouts/Page.astro';
import Lightbox from '../components/Lightbox.astro';
import { getPhotos, photoLine } from '../lib/photos';

const photos = (await getPhotos()).filter((p) => p.strand === 'photography');
const items = await Promise.all(
  photos.map(async (p) => ({ p, full: await getImage({ src: p.src, width: Math.min(2000, p.src.width), format: 'webp' }) })),
);
---

<Page title="Photography" eyebrow="Off the clock" hue="periwinkle" description="Photographs by Ekin Başar Gökçe, from film and the darkroom at AFT (METU) to digital." wide>
  <p class="prose lead">
    Photographs from the darkroom at AFT, METU's amateur photography society, and from wherever I happen to be carrying a camera.
  </p>

  {items.length > 0 ? (
    <ul class="gallery" role="list">
      {items.map(({ p, full }, i) => (
        <li>
          <a href={full.src} data-lightbox data-alt={p.alt} data-caption={photoLine(p)}>
            <Picture
              src={p.src}
              alt={p.alt}
              formats={['avif', 'webp']}
              widths={[480, 960, 1440]}
              sizes="(min-width: 72rem) 23rem, (min-width: 40rem) 45vw, 100vw"
              loading={i < 4 ? 'eager' : 'lazy'}
            />
          </a>
          {photoLine(p) && <p class="small muted cap">{photoLine(p)}</p>}
        </li>
      ))}
    </ul>
  ) : (
    <p class="empty muted">I'll add my photographs here soon.</p>
  )}

  <Lightbox />
</Page>

<style>
  .lead { margin-bottom: var(--space-l); color: var(--muted); }
  .gallery {
    list-style: none;
    padding: 0;
    columns: 3 18rem;
    column-gap: var(--space-s);
  }
  .gallery li { break-inside: avoid; margin-bottom: var(--space-s); }
  .gallery a { display: block; border-radius: 0.5rem; overflow: hidden; background: var(--paper-2); }
  .gallery :global(img) { width: 100%; height: auto; transition: scale 0.5s var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    .gallery a:hover :global(img) { scale: 1.03; }
  }
  .cap { margin-top: var(--space-3xs); }
</style>
