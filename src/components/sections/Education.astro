---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Section from '../Section.astro';
import Text from '../Text.astro';
import { span } from '../../lib/format';

interface Props {
  entry: CollectionEntry<'sections'>;
  navId: string;
  index?: number;
}
const { entry, navId, index } = Astro.props;
const items = (await getCollection('education', (e) => !e.data.draft)).sort((a, b) => a.data.order - b.data.order);
const rows = await Promise.all(items.map(async (e) => ({ e, Content: (await render(e)).Content, hasBody: Boolean(e.body?.trim()) })));
---

<Section entry={entry} navId={navId} index={index}>
  <ol class="degrees" role="list" data-stagger>
    {rows.map(({ e, Content, hasBody }) => {
      const d = e.data;
      return (
        <li class="reveal">
          <span class="degree" aria-hidden="true">{d.degree}</span>
          <div class="info">
            <p class="when">{span(d.start, d.end)}</p>
            <h3><span class="visually-hidden">{d.degree}, </span>{d.field}</h3>
            <p class="meta">{d.institution}</p>
            {d.focus && <p class="line"><span class="mono">Focus</span> <Text value={d.focus} /></p>}
            {d.thesis && <p class="line"><span class="mono">Thesis</span> <em><Text value={d.thesis} /></em></p>}
            {hasBody && <div class="body"><Content /></div>}
          </div>
        </li>
      );
    })}
  </ol>
</Section>

<style>
  .degrees { list-style: none; padding: 0; display: grid; gap: 0; }
  .degrees > li {
    display: grid;
    grid-template-columns: minmax(8rem, 15rem) minmax(0, 1fr);
    gap: var(--space-l);
    align-items: baseline;
    padding-block: var(--space-l);
    border-top: 1px solid var(--rule);
  }
  .degrees > li:last-child { border-bottom: 1px solid var(--rule); }
  .degree {
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 100;
    font-style: italic;
    font-size: var(--step-5);
    line-height: 0.8;
    letter-spacing: -0.04em;
    color: var(--hue-ink);
    opacity: 0.9;
  }
  .info h3 { font-size: var(--step-2); margin-top: var(--space-3xs); letter-spacing: -0.02em; }
  .when { font-size: var(--step--1); color: var(--muted); }
  .meta { color: var(--muted); }
  .line { margin-top: var(--space-2xs); max-width: var(--measure); }
  .line .mono { font-size: var(--step--2); text-transform: uppercase; letter-spacing: 0.12em; color: var(--muted); margin-right: 0.6em; }
  @media (max-width: 40rem) {
    .degrees > li { grid-template-columns: 1fr; gap: var(--space-2xs); }
    .degree { font-size: var(--step-4); }
  }
</style>
