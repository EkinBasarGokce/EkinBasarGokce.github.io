---
/**
 * Research interests (from the section's Markdown body) and publications.
 * The publications list stays hidden until publications.yaml has an entry.
 */
import { getCollection, render, type CollectionEntry } from 'astro:content';
import SectionHead from '../SectionHead.astro';
import Molecule from '../Molecule.astro';
import { site, isTodo } from '../../site';

interface Props {
  entry: CollectionEntry<'sections'>;
  navId: string;
}
const { entry, navId } = Astro.props;
const { Content } = await render(entry);
const pubs = (await getCollection('publications')).sort((a, b) => Number(b.data.year) - Number(a.data.year));
const profiles = site.socials.filter((s) => /scholar|orcid|researchgate|semantic/i.test(s.label) && !isTodo(s.href));
---

<section id={entry.id} class="section section--research" data-nav={navId} data-hue={entry.data.hue} aria-labelledby={`${entry.id}-title`}>
  <div class="wrap">
    <SectionHead id={entry.id} title={entry.data.title} eyebrow={entry.data.eyebrow} exit={entry.data.exit} />
    <div class="research-grid">
      <div class="research panel reveal">
        <div class="prose"><Content /></div>
        {profiles.length > 0 && (
          <ul class="links small profiles" role="list">
            {profiles.map((p) => <li><a class="out" href={p.href} target="_blank" rel="me noopener">{p.label}</a></li>)}
          </ul>
        )}
      </div>
      <div class="mol reveal"><Molecule /></div>
    </div>

    {pubs.length > 0 && (
      <>
        <h3 class="pubs-title">Publications</h3>
        <ol class="ledger" role="list" data-stagger>
          {pubs.map((p) => (
            <li class="reveal">
              <p class="when">{p.data.year}<br /><span class="status">{p.data.status}</span></p>
              <div>
                <h3>{p.data.title}</h3>
                <p class="meta">{p.data.authors} · <em>{p.data.venue}</em></p>
                {p.data.links.length > 0 && (
                  <ul class="links small" role="list">
                    {p.data.links.map((l) => <li><a class="out" href={l.href} target="_blank" rel="noopener">{l.label}</a></li>)}
                  </ul>
                )}
              </div>
            </li>
          ))}
        </ol>
      </>
    )}
  </div>
</section>

<style>
  .research-grid { display: grid; grid-template-columns: minmax(0, 52rem) minmax(13rem, 1fr); gap: var(--space-xl); align-items: center; }
  .mol { max-width: 22rem; justify-self: center; width: 100%; }
  @media (max-width: 56rem) {
    .research-grid { grid-template-columns: 1fr; gap: var(--space-l); }
    .mol { max-width: 17rem; }
  }
  .research { max-width: 52rem; padding: var(--space-l); }
  .research .prose { max-width: 44rem; }
  .research :global(p:first-child) {
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 100;
    font-size: var(--step-1);
    line-height: 1.45;
  }
  /* the interests list in the Markdown renders as chips */
  .research :global(ul) {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .research :global(ul li) {
    margin: 0 !important;
    font-size: var(--step--1);
    padding: 0.32em 0.8em;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--hue) 45%, transparent);
    background: color-mix(in srgb, var(--hue) 14%, var(--paper));
  }
  .profiles { margin-top: var(--space-m); }
  .pubs-title { margin-top: var(--space-xl); margin-bottom: var(--space-s); font-size: var(--step-2); }
  .status { text-transform: capitalize; }
</style>
