---
/**
 * Research interests (from the section's Markdown body) and publications.
 * The publications list stays hidden until publications.yaml has an entry.
 */
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Section from '../Section.astro';
import { site, isTodo } from '../../site';

interface Props {
  entry: CollectionEntry<'sections'>;
  navId: string;
  index?: number;
}
const { entry, navId, index } = Astro.props;
const { Content } = await render(entry);
const pubs = (await getCollection('publications')).sort((a, b) => Number(b.data.year) - Number(a.data.year));
const profiles = site.socials.filter((s) => /scholar|orcid|researchgate|semantic/i.test(s.label) && !isTodo(s.href));
---

<section id={entry.id} class="section section--research" data-nav={navId} data-hue={entry.data.hue} aria-labelledby={`${entry.id}-title`}>
  <div class="wrap">
    <div class="research">
      <div class="side">
        <!-- the head is written inline here so the statement can sit beside it -->
        <header class="head">
          <p class="eyebrow">
            {index && <span class="num">{String(index).padStart(2, '0')}</span>}
            {index && entry.data.eyebrow && <span class="line" aria-hidden="true"></span>}
            {entry.data.eyebrow && <span>{entry.data.eyebrow}</span>}
          </p>
          <h2 id={`${entry.id}-title`}>{entry.data.title}</h2>
        </header>
        <div class="molecule" aria-hidden="true">
          <svg viewBox="0 0 200 200">
            <g class="bonds">
              <path d="M100 40 L152 70 L152 130 L100 160 L48 130 L48 70 Z" />
              <path d="M58 76 L58 124 M100 150 L142 126 M142 74 L100 50" />
              <path d="M152 70 L190 48 M48 130 L12 152 M100 160 L100 196" />
            </g>
            <g class="atoms">
              <circle cx="190" cy="48" r="7" /><circle cx="12" cy="152" r="7" /><circle cx="100" cy="196" r="5" />
            </g>
          </svg>
        </div>
      </div>
      <div class="statement prose reveal"><Content /></div>
    </div>

    {profiles.length > 0 && (
      <ul class="links small profiles" role="list">
        {profiles.map((p) => <li><a class="pen out" href={p.href} target="_blank" rel="me noopener">{p.label}</a></li>)}
      </ul>
    )}

    {pubs.length > 0 && (
      <>
        <h3 class="pubs-title">Publications</h3>
        <ol class="ledger" role="list" data-stagger>
          {pubs.map((p) => (
            <li class="reveal">
              <p class="when">{p.data.year}<br /><span class="status">{p.data.status}</span></p>
              <div>
                <h3>{p.data.title}</h3>
                <p class="meta">{p.data.authors} · <em>{p.data.venue}</em></p>
                {p.data.links.length > 0 && (
                  <ul class="links small" role="list">
                    {p.data.links.map((l) => <li><a class="pen out" href={l.href} target="_blank" rel="noopener">{l.label}</a></li>)}
                  </ul>
                )}
              </div>
            </li>
          ))}
        </ol>
      </>
    )}
  </div>
</section>

<style>
  .research {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--space-xl);
    align-items: start;
  }
  .side { position: sticky; top: calc(var(--nav-h) + var(--space-l)); }
  .head { margin-bottom: var(--space-m); }
  .molecule { width: min(14rem, 60%); color: var(--hue-ink); opacity: 0.8; }
  .molecule svg { overflow: visible; }
  .bonds path { fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
  .atoms circle { fill: var(--hue); stroke: currentColor; stroke-width: 2; }
  @media (prefers-reduced-motion: no-preference) {
    .molecule svg { animation: turn 40s linear infinite; }
    @keyframes turn { to { rotate: 360deg; } }
  }

  .statement { max-width: 38rem; }
  .statement :global(p:first-child) {
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 100;
    font-size: var(--step-2);
    line-height: 1.3;
    letter-spacing: -0.015em;
  }
  /* the interests list in the Markdown renders as small mono tags */
  .statement :global(ul) {
    list-style: none;
    padding: 0;
    margin-top: var(--space-l) !important;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.4rem;
  }
  .statement :global(ul li) {
    margin: 0 !important;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    padding: 0.3em 0.65em;
    border-radius: 0.35rem;
    border: 1px solid color-mix(in srgb, var(--hue) 60%, transparent);
    background: color-mix(in srgb, var(--hue) 14%, transparent);
  }
  .profiles { margin-top: var(--space-m); }
  .pubs-title { margin-top: var(--space-xl); margin-bottom: var(--space-s); font-size: var(--step-2); }
  .status { text-transform: capitalize; }

  @media (max-width: 56rem) {
    .research { grid-template-columns: 1fr; gap: var(--space-m); }
    .side { position: static; }
    .molecule { display: none; }
  }
</style>
