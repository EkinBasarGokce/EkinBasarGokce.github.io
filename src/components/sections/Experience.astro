---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Section from '../Section.astro';
import Text from '../Text.astro';
import { span, when } from '../../lib/format';

interface Props {
  entry: CollectionEntry<'sections'>;
  navId: string;
  index?: number;
}
const { entry, navId, index } = Astro.props;
const items = (await getCollection('experience', (e) => !e.data.draft)).sort((a, b) => a.data.order - b.data.order);
const rows = await Promise.all(items.map(async (e) => ({ e, Content: (await render(e)).Content })));
---

<Section entry={entry} navId={navId} index={index}>
  <ol class="ledger xp" role="list" data-stagger>
    {rows.map(({ e, Content }) => {
      const d = e.data;
      const newest = d.roles[0];
      const oldest = d.roles[d.roles.length - 1];
      const dates = span(oldest.start, newest.end ?? newest.start);
      const path = [...d.roles].reverse().map((r) => r.title).join(', then ');
      return (
        <li class="reveal">
          <p class="when">{oldest.start ? dates : newest.end ? when(newest.end) : ''}</p>
          <div>
            <h3>{newest.title} <span class="org">at {d.org}</span></h3>
            {(d.unit || d.location) && (
              <p class="meta">
                {d.unit && <Text value={d.unit} />}
                {d.unit && d.location && ' · '}
                {d.location}
              </p>
            )}
            {d.roles.length > 1 && <p class="path mono">{path}</p>}
            <div class="body"><Content /></div>
            {d.tags.length > 0 && (
              <ul class="chips" role="list">
                {d.tags.map((t) => <li class="chip">{t}</li>)}
              </ul>
            )}
          </div>
        </li>
      );
    })}
  </ol>
</Section>

<style>
  .org { color: var(--muted); font-style: italic; font-variation-settings: 'SOFT' 100; }
  .path {
    margin-top: var(--space-2xs);
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
  }
  .xp > li { transition: background-color 0.3s ease; }
  @media (hover: hover) and (pointer: fine) {
    .xp > li:hover { background: linear-gradient(90deg, color-mix(in srgb, var(--coral) 10%, transparent), transparent 70%); }
  }
</style>
