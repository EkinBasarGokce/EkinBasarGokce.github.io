---
import fs from 'node:fs';
import path from 'node:path';
import type { CollectionEntry } from 'astro:content';
import Section from '../Section.astro';
import Text from '../Text.astro';
import { site, isTodo } from '../../site';

interface Props {
  entry: CollectionEntry<'sections'>;
  navId: string;
}
const { entry, navId } = Astro.props;
const hasCv = fs.existsSync(path.join(process.cwd(), 'public', site.cv.replace(/^\//, '')));
const emails = site.emails.map((e) => {
  if (isTodo(e.address) || !e.address.includes('@')) return { ...e, todo: true, u: '', d: '' };
  const [u, d] = e.address.split('@');
  return { ...e, todo: false, u, d };
});
const socials = site.socials;
---

<Section entry={entry} navId={navId}>
  <ul class="ledger mail" role="list">
    {emails.map((e) => (
      <li class="reveal" data-email={e.todo ? undefined : ''} data-u={e.u || undefined} data-d={e.d || undefined}>
        <p class="when">{e.label}</p>
        <div class="addr">
          {e.todo ? (
            <Text value={e.address} />
          ) : (
            <>
              <a data-email-link href="#contact">{e.u} [at] {e.d}</a>
              <button class="btn copy" type="button" data-copy hidden>Copy</button>
            </>
          )}
        </div>
      </li>
    ))}
  </ul>

  <ul class="links elsewhere reveal" role="list">
    {hasCv && <li><a class="btn" href={site.cv}>Download CV (PDF)</a></li>}
    {socials.map((s) => (
      <li>
        {isTodo(s.href) ? (
          <span class="todo" title={s.href}>{s.label}</span>
        ) : (
          <a class="out" href={s.href} rel="me noopener" target="_blank">{s.label}</a>
        )}
      </li>
    ))}
  </ul>
</Section>

<style>
  .mail > li { align-items: center; padding-block: var(--space-s); }
  .mail .when { padding-top: 0; color: var(--ink); font-weight: 500; }
  .addr {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-s);
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 100;
    font-size: var(--step-1);
  }
  .copy { font-family: var(--font-body); }
  .elsewhere { margin-top: var(--space-l); font-weight: 500; }
</style>
