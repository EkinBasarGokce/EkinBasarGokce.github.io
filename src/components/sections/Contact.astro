---
/** The house lights come back up: big addresses, one line each. */
import fs from 'node:fs';
import path from 'node:path';
import type { CollectionEntry } from 'astro:content';
import Section from '../Section.astro';
import Text from '../Text.astro';
import { site, isTodo } from '../../site';

interface Props {
  entry: CollectionEntry<'sections'>;
  navId: string;
  index?: number;
}
const { entry, navId, index } = Astro.props;
const hasCv = fs.existsSync(path.join(process.cwd(), 'public', site.cv.replace(/^\//, '')));
const emails = site.emails.map((e) => {
  if (isTodo(e.address) || !e.address.includes('@')) return { ...e, todo: true, u: '', d: '' };
  const [u, d] = e.address.split('@');
  return { ...e, todo: false, u, d };
});
---

<Section entry={entry} navId={navId} index={index}>
  <ul class="mail" role="list">
    {emails.map((e) => (
      <li class="reveal" data-email={e.todo ? undefined : ''} data-u={e.u || undefined} data-d={e.d || undefined}>
        <p class="label">{e.label}</p>
        <div class="addr">
          {e.todo ? (
            <Text value={e.address} />
          ) : (
            <>
              <a class="pen" data-email-link href="#contact">{e.u} [at] {e.d}</a>
              <button class="btn copy" type="button" data-copy hidden>Copy</button>
            </>
          )}
        </div>
      </li>
    ))}
  </ul>

  <ul class="links elsewhere reveal" role="list">
    {hasCv && <li><a class="btn" href={site.cv}>Download CV (PDF)</a></li>}
    {site.socials.map((s) =>
      isTodo(s.href) ? null : <li><a class="pen out" href={s.href} rel="me noopener" target="_blank">{s.label}</a></li>,
    )}
  </ul>
</Section>

<style>
  .mail { list-style: none; padding: 0; }
  .mail > li { padding-block: var(--space-m); border-top: 1px solid var(--rule); }
  .mail > li:last-child { border-bottom: 1px solid var(--rule); }
  .label { font-size: var(--step--2); text-transform: uppercase; letter-spacing: 0.12em; color: var(--muted); }
  .addr {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-s) var(--space-m);
    margin-top: var(--space-2xs);
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 100;
    font-size: clamp(1.5rem, 0.9rem + 3vw, 3.6rem);
    letter-spacing: -0.025em;
    line-height: 1.1;
  }
  .addr a { text-decoration: none; overflow-wrap: anywhere; }
  .copy { font-family: var(--font-mono); font-size: var(--step--2); text-transform: uppercase; letter-spacing: 0.1em; }
  .elsewhere { margin-top: var(--space-l); font-family: var(--font-mono); font-size: var(--step--2); text-transform: uppercase; letter-spacing: 0.1em; }
</style>
