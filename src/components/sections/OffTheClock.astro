---
/**
 * The creative half: one section, a row of strand chips, and one Strand per
 * file in src/content/strands/. Adding a strand = adding one .md file there.
 *
 * It is the inverse of the rest of the page: it fades in from above (the
 * dusk) into dark in the light theme, or into cream in the dark theme, and
 * keeps its own stage lights and a pointer spotlight while you read.
 */
import { getCollection, render, type CollectionEntry } from 'astro:content';
import SectionHead from '../SectionHead.astro';
import Strand from '../Strand.astro';
import Lightbox from '../Lightbox.astro';

interface Props {
  entry: CollectionEntry<'sections'>;
  navId: string;
}
const { entry, navId } = Astro.props;
const { Content } = await render(entry);
const strands = (await getCollection('strands', (s) => !s.data.draft)).sort((a, b) => a.data.order - b.data.order);
---

<section
  id={entry.id}
  class="section otc night"
  data-nav={navId}
  data-hue={entry.data.hue}
  data-night
  aria-labelledby={`${entry.id}-title`}
>
  <div class="dusk" data-dusk aria-hidden="true"></div>
  <div class="night-field" data-night-field aria-hidden="true">
    <i class="blob blob--amber"></i>
    <i class="blob blob--coral"></i>
    <i class="blob blob--periwinkle"></i>
    <i class="blob blob--mauve"></i>
    <i class="spot"></i>
  </div>

  <div class="wrap">
    <SectionHead id={entry.id} title={entry.data.title} eyebrow={entry.data.eyebrow} />
    <div class="intro reveal"><Content /></div>

    <div class="otc-body" data-strands>
      <nav class="strand-nav" aria-label="Off the clock">
        <ul role="list">
          {strands.map((s) => (
            <li>
              <a href={`#${s.id}`} data-chip={s.id} data-hue={s.data.hue} class="chip">{s.data.title}</a>
            </li>
          ))}
        </ul>
      </nav>
      {strands.map((s) => <Strand strand={s} />)}
    </div>
  </div>
  <Lightbox />
</section>

<style>
  .otc {
    position: relative;
    isolation: isolate;
    padding-top: 0;
    padding-bottom: var(--space-2xl);
    color: var(--ink);
    background: linear-gradient(to bottom, transparent 0, var(--night) 36vh);
  }
  /* the lights change: a tall gradient from the page into the night */
  .dusk { height: 36vh; }
  .night-field {
    position: sticky;
    top: 0;
    height: 100vh;
    margin-bottom: -100vh;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .strand-nav ul { display: flex; flex-wrap: wrap; gap: 0.45rem; }
  .chip {
    text-decoration: none;
    font-weight: 500;
    padding: 0.45em 0.95em;
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }
  .chip::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--hue);
  }
  .strand-nav .chip[aria-current='true'] {
    background: color-mix(in srgb, var(--hue) 34%, var(--paper));
    border-color: color-mix(in srgb, var(--hue) 75%, transparent);
  }
</style>
