---
/** Music: a panel in the band's own colours, with its logo, profile badge and a live photo. */
import type { ImageMetadata, GetImageResult } from 'astro';
import { Image, Picture } from 'astro:assets';
import InstagramBadge from '../InstagramBadge.astro';
import { photoLine, type Photo } from '../../lib/photos';

interface Props {
  name: string;
  logo?: ImageMetadata;
  logoAlt?: string;
  card?: { label: string; sub?: string; href: string; tiles: string[] };
  photo?: { p: Photo; full: GetImageResult };
  links: { label: string; href: string }[];
}
const { name, logo, logoAlt, card, photo, links } = Astro.props;
---

<div class="band reveal">
  {logo && (
    <div class="logo">
      <Image src={logo} alt={logoAlt ?? `${name} logo`} width={520} height={520} />
    </div>
  )}

  <div class="side">
    {card && (
      <InstagramBadge name={card.label} handle={card.sub ?? ''} href={card.href} avatar={logo} avatarAlt={logoAlt} tiles={card.tiles} />
    )}
    {links.length > 0 && (
      <ul class="links" role="list">
        {links.map((l) => (
          <li><a class="yt" href={l.href} target="_blank" rel="noopener"><span class="play" aria-hidden="true"></span>{l.label} ↗</a></li>
        ))}
      </ul>
    )}
  </div>

  {photo && (
    <figure class="live">
      <a href={photo.full.src} data-lightbox data-alt={photo.p.alt} data-caption={photoLine(photo.p)}>
        <Picture src={photo.p.src} alt={photo.p.alt} formats={['avif', 'webp']} widths={[400, 800]} sizes="(min-width: 64rem) 18rem, 80vw" />
      </a>
      {photoLine(photo.p) && <figcaption class="mono">{photoLine(photo.p)}</figcaption>}
    </figure>
  )}
</div>

<style>
  .band {
    /* Eksi's navy and red; the panel keeps its own colours in both themes */
    color-scheme: dark;
    --paper: var(--eksi-navy);
    --panel: rgb(255 255 255 / 0.06);
    --rule: rgb(255 255 255 / 0.14);
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr) minmax(0, 0.8fr);
    gap: var(--space-l);
    align-items: center;
    padding: var(--space-l);
    border-radius: calc(var(--radius) * 1.6);
    background:
      radial-gradient(60% 80% at 15% 20%, rgb(255 80 80 / 0.22), transparent 60%),
      var(--eksi-navy);
    color: #fff;
    box-shadow: 0 40px 90px -40px rgb(1 40 95 / 0.9), inset 0 0 0 1px rgb(255 255 255 / 0.08);
  }
  .logo :global(img) { width: 100%; height: auto; border-radius: 1rem; }
  .side { display: grid; gap: var(--space-m); align-content: center; }
  .side :global(.ig) { max-width: none; }
  .links { list-style: none; padding: 0; }
  .yt {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 1.2rem;
    border-radius: 999px;
    background: var(--eksi-red);
    color: #fff;
    font-weight: 600;
    text-decoration: none;
    transition: translate 0.25s var(--ease-out), box-shadow 0.25s ease;
  }
  .yt:hover { translate: 0 -2px; box-shadow: 0 10px 24px -10px rgb(255 80 80 / 0.9); }
  .play { width: 0; height: 0; border-style: solid; border-width: 0.35rem 0 0.35rem 0.6rem; border-color: transparent transparent transparent #fff; }
  .live { display: grid; gap: 0.4rem; }
  .live a { display: block; border-radius: 0.8rem; overflow: hidden; aspect-ratio: 3 / 4; }
  .live :global(picture), .live :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .live figcaption { font-size: 0.62rem; letter-spacing: 0.1em; text-transform: uppercase; color: rgb(255 255 255 / 0.65); }

  @media (max-width: 64rem) {
    .band { grid-template-columns: 1fr 1fr; }
    .live { grid-column: 1 / -1; max-width: 22rem; }
  }
  @media (max-width: 40rem) {
    .band { grid-template-columns: 1fr; padding: var(--space-m); }
    .logo { max-width: 16rem; }
  }
</style>
