---
import InkRule from './InkRule.astro';
import { inline } from '../lib/format';

interface Props {
  id: string;
  title: string;
  eyebrow?: string;
  /** one way out of the section, e.g. "All photographs" */
  exit?: { label: string; href: string };
  level?: 2 | 3;
}
const { id, title, eyebrow, exit, level = 2 } = Astro.props;
const Tag = level === 2 ? 'h2' : 'h3';
---

<header class="head">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <div class="head-row">
    <Tag id={`${id}-title`} set:html={inline(title)} />
    {exit && <a class="exit" href={exit.href}>{exit.label} →</a>}
  </div>
  <InkRule seed={id} />
</header>
