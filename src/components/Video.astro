---
/**
 * Click-to-load YouTube. The poster is downloaded at build time and served
 * from this site; the player (youtube-nocookie.com) loads only on play.
 */
import { Image } from 'astro:assets';

interface Props {
  id: string;
  title: string;
  role?: string;
  year?: string;
  start?: number;
}
const { id, title, role, year, start } = Astro.props;
const meta = [role, year].filter(Boolean).join(' · ');
---

<figure class="video">
  <div class="frame">
    <button class="yt" type="button" data-yt={id} data-title={title} data-start={start} aria-label={`Play video: ${title}`}>
      <Image src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt="" width={480} height={360} loading="lazy" decoding="async" />
      <span class="play" aria-hidden="true"></span>
    </button>
  </div>
  <figcaption>
    <span class="title">{title}</span>
    {meta && <span class="small muted">{meta}</span>}
    <a class="small out" href={`https://www.youtube.com/watch?v=${id}`} target="_blank" rel="noopener">Watch on YouTube</a>
  </figcaption>
</figure>

<style>
  .video { display: grid; gap: var(--space-2xs); }
  .frame {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--paper-2);
    box-shadow: 0 14px 34px rgb(60 40 80 / 0.12);
  }
  .yt { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  /* hqdefault is 4:3 with letterbox bars; cover inside 16:9 crops them away */
  .yt :global(img) { width: 100%; height: 100%; object-fit: cover; transition: scale 0.5s var(--ease-out); }
  .play {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 4rem;
    height: 4rem;
    margin: -2rem 0 0 -2rem;
    border-radius: 50%;
    background: color-mix(in srgb, #fcfaf5 82%, transparent);
    box-shadow: 0 6px 24px rgb(0 0 0 / 0.18);
    transition: scale 0.25s var(--ease-out);
  }
  .play::after {
    content: '';
    position: absolute;
    left: 55%;
    top: 50%;
    translate: -50% -50%;
    border-style: solid;
    border-width: 0.6rem 0 0.6rem 1rem;
    border-color: transparent transparent transparent #211d1a;
  }
  @media (hover: hover) and (pointer: fine) {
    .yt:hover :global(img) { scale: 1.03; }
    .yt:hover .play { scale: 1.08; }
  }
  .frame :global(.yt-frame) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  figcaption { display: flex; flex-wrap: wrap; gap: 0.2rem 0.8rem; align-items: baseline; }
  .title { font-weight: 500; }
</style>
