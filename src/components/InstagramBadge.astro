---
/**
 * A small preview of an Instagram profile: avatar in a gradient ring, name,
 * handle, and a three-tile grid (the avatar image, then YouTube stills).
 * It is a drawing of the profile, not an embed: nothing loads from Instagram,
 * and the whole badge links to the profile.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  name: string;
  handle: string;
  href: string;
  avatar?: ImageMetadata;
  avatarAlt?: string;
  /** YouTube video ids */
  tiles?: string[];
}
const { name, handle, href, avatar, avatarAlt, tiles = [] } = Astro.props;
const at = handle.replace(/\s.*$/, '');
const stills = tiles.slice(0, avatar ? 2 : 3);
---

<a class="ig panel glow" href={href} target="_blank" rel="noopener" aria-label={`${name} on Instagram, ${at}`}>
  <div class="top">
    <span class="ring">
      {avatar ? (
        <Image src={avatar} alt={avatarAlt ?? `${name} logo`} width={160} height={160} class="avatar" />
      ) : (
        <span class="avatar blank" aria-hidden="true"></span>
      )}
    </span>
    <span class="who">
      <span class="handle">{at}</span>
      <span class="name">{name}</span>
    </span>
    <svg class="glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
      <rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4.2" /><circle cx="17.3" cy="6.7" r="1.1" fill="currentColor" stroke="none" />
    </svg>
  </div>

  {(avatar || stills.length > 0) && (
    <span class="grid" aria-hidden="true">
      {avatar && <Image src={avatar} alt="" width={360} height={360} class="tile" />}
      {stills.map((id) => (
        <Image src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt="" width={480} height={360} class="tile" loading="lazy" />
      ))}
    </span>
  )}

  <span class="cta">View on Instagram <span aria-hidden="true">↗</span></span>
</a>

<style>
  .ig {
    --hue: var(--coral);
    display: grid;
    gap: var(--space-s);
    grid-column: 1 / -1;
    width: 100%;
    max-width: 26rem;
    padding: var(--space-s);
    text-decoration: none;
    transition: border-color 0.25s ease;
  }
  .ig:hover { border-color: color-mix(in srgb, var(--coral) 55%, transparent); }
  .top { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: var(--space-s); }
  .ring {
    display: grid;
    place-items: center;
    width: 4.25rem;
    height: 4.25rem;
    border-radius: 50%;
    padding: 3px;
    background: conic-gradient(from 210deg, var(--amber), var(--coral), var(--mauve), var(--periwinkle), var(--amber));
  }
  .ring :global(.avatar) {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--paper);
  }
  .blank { background: var(--paper-2); }
  .who { display: grid; line-height: 1.25; min-width: 0; }
  .handle { font-weight: 600; overflow: hidden; text-overflow: ellipsis; }
  .name { font-size: var(--step--1); color: var(--muted); }
  .glyph { width: 1.4rem; height: 1.4rem; color: var(--coral-ink); }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 3px; border-radius: 0.5rem; overflow: hidden; }
  .grid :global(.tile) { width: 100%; aspect-ratio: 1; object-fit: cover; display: block; }
  .cta {
    justify-self: start;
    font-size: var(--step--1);
    font-weight: 600;
    padding: 0.45em 1em;
    border-radius: 999px;
    background: color-mix(in srgb, var(--coral) 18%, var(--paper));
    border: 1px solid color-mix(in srgb, var(--coral) 45%, transparent);
  }
</style>
