---
import fs from 'node:fs';
import path from 'node:path';
import { site, isTodo } from '../site';
import { inline } from '../lib/format';

const hasCv = fs.existsSync(path.join(process.cwd(), 'public', site.cv.replace(/^\//, '')));
const [first, ...rest] = site.name.split(' ');
---

<section id="top" class="hero" aria-label="Introduction">
  <div class="wrap grid">
    <div class="copy enter">
      <h1 style="--i:0"><span class="l1">{first} {rest.slice(0, -1).join(' ')}</span><span class="l2">{rest.at(-1)}</span></h1>
      <p class="headline" style="--i:1" set:html={inline(site.hero.headline)} />
      <p class="lede" style="--i:2" set:html={inline(site.hero.lede)} />
      <ul class="links row" role="list" style="--i:3">
        <li><a class="pen" href="#contact">Email</a></li>
        {hasCv && <li><a class="pen" href={site.cv}>CV</a></li>}
        {site.socials.map((s) =>
          isTodo(s.href) ? null : (
            <li><a class="pen out" href={s.href} rel="me noopener" target="_blank">{s.label}</a></li>
          ),
        )}
      </ul>
      <p class="bridge" style="--i:4" set:html={inline(site.hero.bridge)} />
    </div>

    <figure class="doodle">
      <button type="button" class="doodle-btn" data-doodle-trigger aria-label="Draw another face">
        <span class="lean" data-lean>
          <canvas data-doodle="hero" width="420" height="420" role="img" aria-label="A hand-drawn doodle face, standing in for a portrait"></canvas>
        </span>
      </button>
      <figcaption>
        <span class="cap">self-portrait, approximately</span>
        <span class="hint mono">tap to redraw</span>
      </figcaption>
    </figure>
  </div>

  <p class="wrap cue mono" aria-hidden="true"><span class="cue-line"></span>{site.hero.cue}</p>
</section>

<style>
  .hero {
    min-height: calc(100svh - var(--nav-h));
    display: grid;
    grid-template-rows: 1fr auto;
    padding-block: var(--space-xl) var(--space-l);
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(16rem, 0.75fr);
    gap: var(--space-l);
    align-items: center;
  }
  h1 { display: grid; }
  h1 .l2 { padding-left: 0.6em; font-style: italic; font-variation-settings: 'SOFT' 100, 'WONK' 1; }

  .headline {
    margin-top: var(--space-l);
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 100;
    font-size: var(--step-3);
    line-height: 1.1;
    letter-spacing: -0.02em;
    max-width: 18ch;
  }
  /* "on stage by night" is printed in negative: a preview of what is coming */
  .headline :global(em) {
    font-style: italic;
    /* a true negative of whichever theme is on */
    background: var(--ink);
    color: var(--paper);
    padding: 0.02em 0.28em 0.08em;
    border-radius: 0.2em;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.04), 0 10px 30px -12px rgb(255 140 100 / 0.6);
  }
  .lede { margin-top: var(--space-m); max-width: 46ch; font-size: var(--step-0); color: var(--muted); line-height: 1.65; }
  .lede :global(a) { color: var(--ink); }
  .row {
    margin-top: var(--space-m);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .bridge { margin-top: var(--space-m); max-width: 46ch; padding-top: var(--space-s); border-top: 1px solid var(--rule); color: var(--muted); }

  .doodle { position: relative; justify-self: center; display: grid; justify-items: center; gap: var(--space-xs); }
  .doodle::before {
    content: '';
    position: absolute;
    inset: -14% -20% 4%;
    z-index: -1;
    border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--amber) calc(var(--peak) * 0.85), transparent), color-mix(in srgb, var(--coral) calc(var(--peak) * 0.35), transparent) 55%, transparent);
  }
  .doodle-btn { border-radius: 50%; cursor: pointer; touch-action: manipulation; }
  .lean { display: block; transition: transform 0.6s var(--ease-out); transform: rotate(var(--tilt, 0deg)) translate(var(--nx, 0px), var(--ny, 0px)); }
  .doodle canvas { width: min(26rem, 34vw); height: min(26rem, 34vw); }
  figcaption { display: grid; justify-items: center; gap: 0.2rem; }
  .cap { font-family: var(--font-display); font-style: italic; color: var(--muted); }
  .hint { font-size: var(--step--2); text-transform: uppercase; letter-spacing: 0.12em; color: var(--muted); opacity: 0.8; }

  .cue {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--muted);
  }
  .cue-line { width: 3rem; height: 1px; background: currentColor; transform-origin: left; }
  @media (prefers-reduced-motion: no-preference) {
    .doodle { animation: enter 1s var(--ease-out) 0.2s both; }
    .cue-line { animation: cue 2.4s var(--ease-in-out) infinite; }
    @keyframes cue { 0%, 100% { scale: 0.3 1; } 50% { scale: 1 1; } }
  }

  @media (max-width: 56rem) {
    .hero { min-height: auto; }
    .grid { grid-template-columns: 1fr; gap: var(--space-m); }
    .doodle { order: -1; justify-self: start; grid-template-columns: auto 1fr; align-items: center; gap: var(--space-s); }
    .doodle canvas { width: 9.5rem; height: 9.5rem; }
    figcaption { justify-items: start; }
    .cue { margin-top: var(--space-l); }
  }
</style>

<script>
  import { mountDoodles } from '../scripts/doodle';
  mountDoodles();
</script>
