---
/** About: your own intro text from the home page, opened in Notepad. Visitors can type in it; nothing is saved. */
import Window from '../Window.astro';
import type { Menu } from '../types';
import { site } from '../../../site';

const plain = (s: string) => s.replace(/\[([^\]]+)\]\([^)]+\)/g, '$1');
const text = [site.name, '', plain(site.hero.lede), '', plain(site.hero.bridge), ''].join('\n');

const menus: Menu[] = [
  { label: '&File', items: [{ label: 'E&xit', action: 'close' }] },
  {
    label: '&Edit',
    items: [
      { label: '&Undo', action: 'undo', key: 'Ctrl+Z' },
      'sep',
      { label: 'Cu&t', action: 'cut', key: 'Ctrl+X' },
      { label: '&Copy', action: 'copy', key: 'Ctrl+C' },
      { label: '&Paste', action: 'paste', key: 'Ctrl+V' },
      { label: 'De&lete', action: 'delete', key: 'Del' },
      'sep',
      { label: 'Select &All', action: 'selectall' },
      { label: 'Time/&Date', action: 'timedate', key: 'F5' },
      'sep',
      { label: '&Word Wrap', action: 'wrap', checked: true },
    ],
  },
];
---

<Window id="about" title="about.txt - Notepad" icon="notepad" w={500} h={320} menus={menus} class="notepad">
  <textarea aria-label="about.txt" spellcheck="false" wrap="soft" data-autofocus>{text}</textarea>
</Window>
