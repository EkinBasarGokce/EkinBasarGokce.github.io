---
/**
 * The Desktop page: icons from src/content/desktop.yaml on a green-hill wallpaper,
 * the app windows, the taskbar and the Start menu.
 *
 * Visitors can drag the icons around; where they leave them is remembered in
 * their browser, and right-click > Arrange Icons puts them back.
 *
 * Add a link icon: one entry in desktop.yaml.
 * Add an app: a component in ./apps/ (a <Window id="...">), render it below,
 * add its id to APPS, then point an icon at it with `app: id`.
 */
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import { iconUri } from '../../lib/pixel';
// Wallpaper: photo by Se. Tsuchiya on Unsplash (Unsplash License), unsplash.com/photos/SVVKbAy5CDc
import wallpaper from '../../assets/desktop/wallpaper.jpg';
import Taskbar from './Taskbar.astro';
import StartMenu from './StartMenu.astro';
import MenuList from './MenuList.astro';
import About from './apps/About.astro';
import Mail from './apps/Mail.astro';
import MediaPlayer from './apps/MediaPlayer.astro';
import Paint from './apps/Paint.astro';
import RecycleBin from './apps/RecycleBin.astro';
import DateTime from './apps/DateTime.astro';
import ShutDown from './apps/ShutDown.astro';

const APPS = ['about', 'mail', 'media', 'paint', 'recycle', 'datetime'];
/** programs that draw their own windows (scripts/desktop/winamp.ts) */
const EXTERNAL = ['winamp'];

const icons = (await getCollection('desktop', (e) => !e.data.draft)).sort((a, b) => a.data.order - b.data.order);
for (const i of icons) {
  if (i.data.app && !APPS.includes(i.data.app) && !EXTERNAL.includes(i.data.app)) {
    throw new Error(`desktop.yaml: "${i.id}" opens an unknown app "${i.data.app}". Known apps: ${[...APPS, ...EXTERNAL].join(', ')}.`);
  }
}
const tracks = (await getCollection('music', (m) => !m.data.draft))
  .sort((a, b) => a.data.order - b.data.order)
  .map(({ data: m }) => ({ url: m.src, title: m.title, artist: m.artist, duration: m.duration }));
const hasWinamp = icons.some((i) => i.data.app === 'winamp');
---

<div class="screen">
  <main class="desktop" data-desktop>
    <div class="wallpaper" aria-hidden="true">
      <Picture src={wallpaper} alt="" formats={['avif', 'webp']} widths={[960, 1440, 1920, 2560, 3000]} sizes="max(100vw, 150vh)" loading="eager" fetchpriority="high" />
    </div>
    <h1 class="sr-only">Desktop</h1>
    <ul class="icons" role="list" aria-label="Desktop icons">
      {
        icons.map(({ id, data: d }) => (
          <li>
            <a
              class="icon"
              href={d.app ? `#${d.app}` : d.href}
              target={d.newTab ? '_blank' : undefined}
              rel={d.newTab ? 'noopener' : undefined}
              draggable="false"
              data-icon={id}
              data-open={d.app}
            >
              <img src={iconUri(d.icon, { shortcut: !!d.href })} width="32" height="32" alt="" draggable="false" />
              <span>{d.label}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <About />
    <Mail />
    <MediaPlayer />
    <Paint />
    <RecycleBin />
    <DateTime />
  </main>
  <Taskbar />
</div>

<StartMenu winamp={hasWinamp} />
<ShutDown />
{hasWinamp && <script is:inline type="application/json" id="winamp-tracks" data-task-icon={iconUri('winamp')} set:html={JSON.stringify(tracks).replace(/</g, '\\u003c')} />}

<!-- right-click on the empty desktop -->
<div id="desk-menu" class="ctx-menu" popover>
  <MenuList entries={[{ label: 'Arrange &Icons', action: 'arrange' }, 'sep', { label: 'R&efresh', action: 'refresh' }]} class="ctx-list" label="Desktop" />
</div>

<!-- a selected icon is tinted navy, like the real thing -->
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <filter id="selected" color-interpolation-filters="sRGB">
    <feColorMatrix type="matrix" values="0.5 0 0 0 0  0 0.5 0 0 0  0 0 0.5 0 0.25  0 0 0 1 0" />
  </filter>
</svg>

<script>
  import '../../scripts/desktop/main';
</script>
