---
import type { ImageMetadata } from 'astro';
/** One creative practice inside Off the clock. Everything comes from its .md file. */
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Picture, getImage } from 'astro:assets';
import Text from './Text.astro';
import Video from './Video.astro';
import LinkCard from './LinkCard.astro';
import InstagramBadge from './InstagramBadge.astro';
import PosterWall from './strands/PosterWall.astro';
import { getPhotos, getStrandPhotos, photoLine } from '../lib/photos';

interface Props {
  strand: CollectionEntry<'strands'>;
}
const { strand } = Astro.props;
const d = strand.data;
const { Content } = await render(strand);

const wants = (m: 'photos' | 'videos' | 'cards') => d.media.includes(m);
const full = (src: ImageMetadata) => getImage({ src, width: Math.min(2000, src.width), format: 'webp' });

// layout: posters turns the entries into a poster wall; a poster can print a photo
const posters = d.layout === 'posters';
const byId = new Map((await getPhotos()).map((p) => [p.id, p]));
const posterPhotos = new Map(
  await Promise.all(
    d.entries
      .flatMap((e) => (posters ? [e.photo, e.poster] : []))
      .filter((id): id is string => !!id && byId.has(id))
      .map(async (id) => [id, { p: byId.get(id)!, full: await full(byId.get(id)!.src) }] as const),
  ),
);

const photos = wants('photos')
  ? await Promise.all(
      (await getStrandPhotos(strand.id)).filter((p) => !posterPhotos.has(p.id)).map(async (p) => ({
        p,
        full: await getImage({ src: p.src, width: Math.min(2000, p.src.width), format: 'webp' }),
      })),
    )
  : [];
const videos = wants('videos') ? await getCollection('videos', (v) => v.data.strand === strand.id) : [];
const cards = wants('cards') ? await getCollection('cards', (c) => c.data.strand === strand.id) : [];
// "All photographs" only makes sense once there are photographs
const showMore = d.more && !(wants('photos') && photos.length === 0);
const external = (href: string) => /^https?:\/\//.test(href);
---

<article id={strand.id} class="strand" data-strand={strand.id} data-hue={d.hue} aria-labelledby={`${strand.id}-title`}>
  <header class="side reveal">
    <h3 id={`${strand.id}-title`}>{d.title}</h3>
    <span class="bar" aria-hidden="true"></span>
    <p class="kicker">{d.kicker}</p>
  </header>

  <div class="main">
    <div class="prose reveal"><Content /></div>

    {posters && <PosterWall entries={d.entries} photos={posterPhotos} />}

    {!posters && d.entries.length > 0 && (
      <ul class="ledger entries" role="list" data-stagger>
        {d.entries.map((e) => (
          <li class="reveal">
            <p class="when">{e.when && <Text value={e.when} />}</p>
            <div>
              <p class="entry-title">
                {e.href ? <a href={e.href}><Text value={e.title} /></a> : <Text value={e.title} />}
              </p>
              {e.role && <p class="entry-role">{e.role}</p>}
              {e.detail && <p class="small muted"><Text value={e.detail} /></p>}
            </div>
          </li>
        ))}
      </ul>
    )}

    {wants('photos') && photos.length === 0 && d.placeholder && <p class="soon">{d.placeholder}</p>}

    {(photos.length > 0 || cards.length > 0) && (
      <div class="media-row">
        {photos.length > 0 && (
          <ul
            class:list={['photos', 'reveal', { single: photos.length === 1 }]}
            data-orient={photos.length === 1 ? (photos[0].p.src.width >= photos[0].p.src.height ? 'landscape' : 'portrait') : undefined}
            role="list"
          >
            {photos.map(({ p, full }) => (
              <li>
                <a href={full.src} data-lightbox data-alt={p.alt} data-caption={photoLine(p)}>
                  <Picture
                    src={p.src}
                    alt={p.alt}
                    formats={['avif', 'webp']}
                    widths={[320, 640, 960]}
                    sizes={photos.length === 1 ? '(min-width: 40rem) 30rem, 100vw' : '(min-width: 64rem) 16rem, (min-width: 40rem) 30vw, 46vw'}
                  />
                </a>
                {photoLine(p) && <p class="cap small muted">{photoLine(p)}</p>}
              </li>
            ))}
          </ul>
        )}

        {cards.length > 0 && (
          <div class="cards">
            {cards.map((c) =>
              c.data.style === 'badge' && c.data.platform === 'instagram' ? (
                <InstagramBadge name={c.data.label} handle={c.data.sub ?? ''} href={c.data.href} avatar={d.logo} avatarAlt={d.logoAlt} tiles={c.data.tiles} />
              ) : (
                <LinkCard label={c.data.label} sub={c.data.sub} href={c.data.href} platform={c.data.platform} />
              ),
            )}
          </div>
        )}
      </div>
    )}

    {videos.length > 0 && (
      <div class="videos">
        {videos.map((v) => <Video id={v.id} title={v.data.title} role={v.data.role} year={v.data.year} start={v.data.start} />)}
      </div>
    )}

    {(d.links.length > 0 || showMore) && (
      <div class="out-row">
        {showMore && d.more && <a class="btn" href={d.more.href}>{d.more.label} →</a>}
        {d.links.length > 0 && (
          <ul class="links small" role="list">
            {d.links.map((l) =>
              external(l.href) ? (
                <li><a class="out" href={l.href} target="_blank" rel="noopener">{l.label}</a></li>
              ) : (
                <li><a href={l.href}>{l.label}</a></li>
              ),
            )}
          </ul>
        )}
      </div>
    )}
  </div>
</article>

<style>
  .strand {
    display: grid;
    grid-template-columns: minmax(10rem, 15rem) minmax(0, 1fr);
    gap: var(--space-l) var(--space-xl);
    padding-block: var(--space-xl);
    border-top: 1px solid var(--rule);
    scroll-margin-top: calc(var(--nav-h) + 4rem);
  }
  .side { position: sticky; top: calc(var(--nav-h) + 4.5rem); align-self: start; }
  .side h3 { font-size: var(--step-2); }
  .bar {
    display: block;
    width: 2.5rem;
    height: 3px;
    border-radius: 2px;
    margin-block: var(--space-xs);
    background: var(--hue);
  }
  .kicker { color: var(--muted); font-size: var(--step--1); max-width: 22ch; }
  .main { display: grid; gap: var(--space-m); min-width: 0; }
  .entries { --ledger: 7.5rem; }
  .entries > li { padding-block: var(--space-xs); }
  .entry-title { font-weight: 500; }
  .entry-role { font-size: var(--step--1); color: var(--hue-ink); margin-top: 0.1rem; }
  .soon { color: var(--muted); font-style: italic; font-family: var(--font-display); font-variation-settings: 'SOFT' 100; }

  .photos {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-2xs);
  }
  .photos a { display: block; border-radius: 0.5rem; overflow: hidden; aspect-ratio: 4 / 5; background: var(--paper-2); }
  .cap { margin-top: 0.35rem; }
  /* a lone photo keeps its own shape instead of the 4:5 crop */
  .photos.single { display: block; }
  .photos.single[data-orient='portrait'] { width: min(100%, 17rem); }
  .photos.single[data-orient='landscape'] { width: min(100%, 30rem); }
  .photos.single a { aspect-ratio: auto; }
  .photos :global(picture) { display: block; height: 100%; }
  .photos.single :global(picture),
  .photos.single :global(img) { height: auto; }
  .media-row { display: flex; flex-wrap: wrap; gap: var(--space-m); align-items: flex-start; }
  .media-row > .photos { flex: 1 1 100%; }
  .media-row > .photos.single { flex: 0 0 auto; }
  .media-row > .cards { flex: 1 1 18rem; max-width: 26rem; }
  .photos :global(img) { width: 100%; height: 100%; object-fit: cover; transition: scale 0.5s var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    .photos a:hover :global(img) { scale: 1.04; }
  }
  .videos { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr)); gap: var(--space-m); }
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr)); gap: var(--space-s); }
  .out-row { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-s) var(--space-m); }

  @media (max-width: 48rem) {
    .strand { grid-template-columns: 1fr; gap: var(--space-s); padding-block: var(--space-l); }
    .side { position: static; }
    .photos { grid-template-columns: repeat(2, 1fr); }
  }
</style>
